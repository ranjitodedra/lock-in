# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only; bypasses RLS — required for admin page and cron in production
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OAuth redirect base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Codex device-code OAuth (ChatGPT subscription extraction)
CODEX_CLIENT_ID=your-codex-client-id
CODEX_MODEL=gpt-5.5

# Protects /api/cron/cleanup-extraction-usage (required on Vercel production)
CRON_SECRET=generate-a-random-secret

# Inngest — async extraction workers (https://app.inngest.com)
# Local: run `npx inngest-cli@latest dev` against http://localhost:3000/api/inngest
# Production: set keys from the Inngest dashboard (SDK reads these automatically)
# INNGEST_EVENT_KEY=your-event-key
# INNGEST_SIGNING_KEY=your-signing-key

# Admin panel access — email must match signed-in Supabase user
ADMIN_EMAIL=you@example.com

# Google OAuth setup scripts only (scripts/setup-google-oauth.mjs)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional error reporting (monitoring stub; Sentry SDK not yet wired)
# NEXT_PUBLIC_SENTRY_DSN=https://example@sentry.io/123
